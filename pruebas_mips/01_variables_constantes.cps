// Declaración y asignación de variables y constantes
const PI: integer = 314;
const SALUDO: string = "Hola";
let a: integer = 10;
let b: integer;
let activo: boolean = true;
let nombre: string = "Compiscript";
let nada = null;
var antiguo: integer = 7;

b = a + 5;
a = b;
antiguo = antiguo + PI;

print(PI);
print(SALUDO);
print(a);
print(b);
print(activo);
print(nombre);
print(nada);
print(antiguo);


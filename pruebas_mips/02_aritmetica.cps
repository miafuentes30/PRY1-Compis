// Expresiones aritméticas: precedencia, agrupamiento, negativos, división y módulo
let x: integer = 5 + 3 * 2;
let z: integer = (1 + 2) * 3;
let r: integer = 17 / 5;
let m: integer = 17 % 5;
let n: integer = -x + 4;
let q: integer = (0 - 17) / 5;
let w: integer = (0 - 17) % 5;
let mezcla: integer = (x + z) * (x - z) / 2 - m;
print(x);
print(z);
print(r);
print(m);
print(n);
print(q);
print(w);
print(mezcla);
print(2 + 3 * 4 - 6 / 2);
print(100 - 3 - 2 - 1);
print(2 * 3 * 4 % 7);
print(-(-8));
let grande: integer = 2147483647;
grande = grande + 1;
print(grande);
let doble: integer = x * 2;
let cuadruple: integer = x * 4;
let igual: integer = x * 1 + 0;
print(doble);
print(cuadruple);
print(igual);
